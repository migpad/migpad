// The resources of migpad.exe: the icon — which GPUI gives the windows too, by its number 1 — and
// the version that Explorer shows. build.rs puts in the version and the path of the icon.
1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @NUMBERS@
PRODUCTVERSION @NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MigPad"
            VALUE "FileDescription", "MigPad"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "migpad"
            VALUE "LegalCopyright", "Copyright (c) 2026 Iaroslav Vorobev"
            VALUE "OriginalFilename", "migpad.exe"
            VALUE "ProductName", "MigPad"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
