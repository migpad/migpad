<!DOCTYPE html>
<html lang="en">
<!-- The licenses of the components MigPad is built from: cargo-about fills this template, see about.toml. -->
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MigPad — Third-Party Licenses</title>
    <style>
        :root { color-scheme: light dark; }
        body { font: 15px/1.5 -apple-system, "Segoe UI", system-ui, sans-serif; max-width: 860px; margin: 0 auto; padding: 24px; }
        a { color: #2f6fde; }
        @media (prefers-color-scheme: dark) { a { color: #6aa6ff; } }
        h1 { font-size: 1.6em; }
        h2 { font-size: 1.25em; margin-top: 2em; }
        .used-by { margin: 0 0 8px; padding-left: 20px; }
        pre { white-space: pre-wrap; font-size: 13px; padding: 12px; border: 1px solid #8884; border-radius: 6px; max-height: 360px; overflow-y: auto; }
    </style>
</head>
<body>
    <h1>Third-party licenses</h1>
    <p>MigPad is released under the MIT License. It is built from the open-source components below, each under its own license. The source code of each version of a component is on its page on crates.io.</p>
    <h2>Licenses</h2>
    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> — {{count}}</li>
        {{/each}}
    </ul>
    {{#each licenses}}
    {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
    <p>Used by:</p>
    <ul class="used-by">
        {{#each used_by}}
        <li><a href="https://crates.io/crates/{{crate.name}}/{{crate.version}}">{{crate.name}} {{crate.version}}</a>{{#if crate.repository}} — <a href="{{crate.repository}}">{{crate.repository}}</a>{{/if}}</li>
        {{/each}}
    </ul>
    <pre>{{text}}</pre>
    {{/each}}
</body>
</html>
